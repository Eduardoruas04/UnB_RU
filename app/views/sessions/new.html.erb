<div style="max-width: 440px; margin: 40px auto; font-family: system-ui, -apple-system, sans-serif;">
  <div style="background: #004b23; color: white; padding: 18px; border-radius: 8px 8px 0 0; text-align: center;">
    <h1 style="margin: 0; font-size: 1.4rem;">Login da Aplicação de Controle</h1>
    <p style="margin: 6px 0 0; font-size: 0.9rem;">Acesso exclusivo para funcionários do RU</p>
  </div>

  <div style="border: 1px solid #dee2e6; border-top: none; padding: 24px; border-radius: 0 0 8px 8px; background: #fff;">
    <% if flash[:notice] %>
      <div style="background: #d4edda; color: #155724; padding: 10px; margin-bottom: 16px; border-radius: 6px; border: 1px solid #c3e6cb;">
        <%= flash[:notice] %>
      </div>
    <% end %>

    <% if flash[:alert] %>
      <div style="background: #f8d7da; color: #721c24; padding: 10px; margin-bottom: 16px; border-radius: 6px; border: 1px solid #f5c6cb;">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <%= form_with url: login_path, method: :post, local: true do |f| %>
      <div style="margin-bottom: 16px;">
        <%= f.label :matricula, "Matrícula", style: "display: block; font-weight: 600; margin-bottom: 6px;" %>
        <%= f.text_field :matricula, placeholder: "Ex: FUNC01", style: "width: 100%; padding: 10px; border: 1px solid #ced4da; border-radius: 4px; box-sizing: border-box;" %>
      </div>

      <div style="margin-bottom: 20px;">
        <%= f.label :password, "Senha", style: "display: block; font-weight: 600; margin-bottom: 6px;" %>
        <%= f.password_field :password, placeholder: "Digite sua senha", style: "width: 100%; padding: 10px; border: 1px solid #ced4da; border-radius: 4px; box-sizing: border-box;" %>
      </div>

      <%= f.submit "Entrar", style: "width: 100%; background: #004b23; color: white; border: none; padding: 12px; border-radius: 4px; font-weight: 600; cursor: pointer;" %>
    <% end %>

    <p style="margin-top: 16px; text-align: center;">
      <%= link_to "Voltar para Central de Testes", root_path, style: "color: #004b23; text-decoration: none;" %>
    </p>
  </div>
</div>
