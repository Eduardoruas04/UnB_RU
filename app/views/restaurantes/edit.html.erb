<div style="max-width: 640px; margin: 32px auto; padding: 0 20px;">
  <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 10px; padding: 24px; box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);">
    <h1 style="margin: 0 0 20px 0; font-size: 1.5rem; color: #0f3d7a;">Editar restaurante</h1>

    <%= form_with model: @restaurante do |f| %>
      <%= render "restaurantes/erros", registro: @restaurante %>

      <div style="margin-bottom: 14px;">
        <%= f.label :nome, "Nome do restaurante", style: "display: block; font-size: 0.85rem; font-weight: 600; color: #334155; margin-bottom: 6px;" %>
        <%= f.text_field :nome, style: "width: 100%; box-sizing: border-box; padding: 9px 12px; border: 1px solid #cbd5e1; border-radius: 7px;" %>
      </div>

      <div style="margin-bottom: 18px;">
        <%= f.label :campus, "Campus", style: "display: block; font-size: 0.85rem; font-weight: 600; color: #334155; margin-bottom: 6px;" %>
        <%= f.text_field :campus, style: "width: 100%; box-sizing: border-box; padding: 9px 12px; border: 1px solid #cbd5e1; border-radius: 7px;" %>
      </div>

      <div style="display: flex; align-items: center; gap: 12px;">
        <%= f.submit "Atualizar restaurante", style: "background: #0f3d7a; color: #ffffff; border: none; border-radius: 7px; padding: 9px 16px; font-weight: 600; cursor: pointer;" %>
        <%= link_to "Voltar", restaurantes_path, style: "color: #0f3d7a; font-weight: 600; text-decoration: none;" %>
      </div>
    <% end %>
  </div>
</div>