<div style="max-width: 520px; margin: 40px auto; font-family: system-ui, -apple-system, sans-serif;">
  <div style="background: #004b23; color: white; padding: 18px; border-radius: 8px 8px 0 0; text-align: center;">
    <h1 style="margin: 0; font-size: 1.4rem;">Avaliar Refeição do RU</h1>
    <p style="margin: 6px 0 0; font-size: 0.9rem;">Conte-nos como foi sua experiência hoje</p>
  </div>

  <div style="border: 1px solid #dee2e6; border-top: none; padding: 24px; border-radius: 0 0 8px 8px; background: #fff;">
    <% if flash[:notice] %>
      <div style="background: #d4edda; color: #155724; padding: 10px; margin-bottom: 16px; border-radius: 6px; border: 1px solid #c3e6cb;">
        <%= flash[:notice] %>
      </div>
    <% end %>

    <% if flash[:alert] %>
      <div style="background: #f8d7da; color: #721c24; padding: 10px; margin-bottom: 16px; border-radius: 6px; border: 1px solid #f5c6cb;">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <%= form_with model: @avaliacao, url: avaliacoes_path, local: true do |f| %>
      <div style="margin-bottom: 16px;">
        <%= f.label :nota, "Nota", style: "display: block; font-weight: 600; margin-bottom: 6px;" %>
        <%= f.select :nota, options_for_select([1, 2, 3, 4, 5], @avaliacao.nota), { include_blank: "Selecione uma nota" }, style: "width: 100%; padding: 10px; border: 1px solid #ced4da; border-radius: 4px; box-sizing: border-box;" %>
      </div>

      <div style="margin-bottom: 20px;">
        <%= f.label :comentario, "Comentário", style: "display: block; font-weight: 600; margin-bottom: 6px;" %>
        <%= f.text_area :comentario, rows: 4, placeholder: "Deixe um comentário opcional sobre a refeição...", style: "width: 100%; padding: 10px; border: 1px solid #ced4da; border-radius: 4px; box-sizing: border-box;" %>
      </div>

      <%= f.submit "Enviar Avaliação", style: "width: 100%; background: #004b23; color: white; border: none; padding: 12px; border-radius: 4px; font-weight: 600; cursor: pointer;" %>
    <% end %>

    <p style="margin-top: 16px; text-align: center;">
      <%= link_to "Voltar para Central de Testes", root_path, style: "color: #004b23; text-decoration: none;" %>
    </p>
  </div>
</div>
