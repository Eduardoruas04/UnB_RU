<div style="max-width: 640px; margin: 32px auto; padding: 0 20px;">
  <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 10px; padding: 24px; box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);">
    <h1 style="margin: 0 0 20px 0; font-size: 1.5rem; color: #0f3d7a;">Editar catraca</h1>

    <%= form_with model: @catraca do |f| %>
      <%= render "restaurantes/erros", registro: @catraca %>

      <div style="margin-bottom: 14px;">
        <%= f.label :codigo_identificador, "Identificador da catraca", style: "display: block; font-size: 0.85rem; font-weight: 600; color: #334155; margin-bottom: 6px;" %>
        <%= f.text_field :codigo_identificador, style: "width: 100%; box-sizing: border-box; padding: 9px 12px; border: 1px solid #cbd5e1; border-radius: 7px;" %>
      </div>

      <div style="margin-bottom: 14px;">
        <%= f.label :restaurante_id, "Restaurante", style: "display: block; font-size: 0.85rem; font-weight: 600; color: #334155; margin-bottom: 6px;" %>
        <%= f.collection_select :restaurante_id, @restaurantes, :id, :nome, { include_blank: "Selecione" }, { style: "width: 100%; box-sizing: border-box; padding: 9px 12px; border: 1px solid #cbd5e1; border-radius: 7px; background: #ffffff;" } %>
      </div>

      <div style="margin-bottom: 18px;">
        <%= f.label :status, "Status", style: "display: block; font-size: 0.85rem; font-weight: 600; color: #334155; margin-bottom: 6px;" %>
        <%= f.select :status, %w[ativa manutencao inativa], {}, { style: "width: 100%; box-sizing: border-box; padding: 9px 12px; border: 1px solid #cbd5e1; border-radius: 7px; background: #ffffff;" } %>
      </div>

      <div style="display: flex; align-items: center; gap: 12px;">
        <%= f.submit "Atualizar catraca", style: "background: #0f3d7a; color: #ffffff; border: none; border-radius: 7px; padding: 9px 16px; font-weight: 600; cursor: pointer;" %>
        <%= link_to "Voltar", restaurantes_path, style: "color: #0f3d7a; font-weight: 600; text-decoration: none;" %>
      </div>
    <% end %>
  </div>
</div>